{
  "info": {
    "name": "Notice Board API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://YOUR-API-ID.execute-api.us-east-1.amazonaws.com" },
    { "key": "noticeId", "value": "" }
  ],
  "item": [
    {
      "name": "Create notice",
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('Status is 201', () => pm.response.to.have.status(201));",
          "pm.collectionVariables.set('noticeId', pm.response.json()._id);"
        ]}
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Welcome\",\n  \"content\": \"First notice from Postman\"\n}" },
        "url": "{{baseUrl}}/notices"
      }
    },
    {
      "name": "Get all notices",
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] } }],
      "request": { "method": "GET", "url": "{{baseUrl}}/notices" }
    },
    {
      "name": "Get one notice",
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] } }],
      "request": { "method": "GET", "url": "{{baseUrl}}/notices/{{noticeId}}" }
    },
    {
      "name": "Update notice",
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] } }],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Welcome (edited)\"\n}" },
        "url": "{{baseUrl}}/notices/{{noticeId}}"
      }
    },
    {
      "name": "Delete notice",
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] } }],
      "request": { "method": "DELETE", "url": "{{baseUrl}}/notices/{{noticeId}}" }
    }
  ]
}
