  "item": [
    {
      "name": "1. Cohorts",
      "item": [
        {
          "name": "Create cohort",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cohorts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cohorts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Cohort {{$timestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('cohortId', data._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List cohorts",
          "request": {
            "method": "GET",
            "header": [],
