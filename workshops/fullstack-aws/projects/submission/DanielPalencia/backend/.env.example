# Copy this file to `.env` in the same directory and fill in the real value.
#
# `.env` is gitignored. This file is not - it exists to tell a teammate WHICH keys they
# need without telling them the secrets, which is the only part of a credential that is
# safe to commit.
#
# Get the connection string from the team's Planning document (Database info), or from
# Atlas: Connect -> Drivers -> Java. Leave the path between `/` and `?` empty so it does
# not override spring.mongodb.database, and URL-encode any special characters in the
# password (@ -> %40, # -> %23, / -> %2F).
GEEKYCHADS_MONGODB_URI=mongodb+srv://USER:PASSWORD@your-cluster.mongodb.net/
